{
  "name": "angular-diploma",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --ui"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
